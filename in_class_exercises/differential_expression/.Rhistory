# ============================================================================
# PharmacoSet2 Validation and Data Access Script
# ============================================================================
library(PharmacoGx)
library(SummarizedExperiment)
library(MultiAssayExperiment)
library(data.table)
library(ggplot2)
# Load your PSet
pset <- readRDS("HMCL_pset.rds")
# ============================================================================
# PART 1: BASIC STRUCTURE VALIDATION
# ============================================================================
cat("\n")
cat("PHARMACOSET2 VALIDATION\n")
cat("PSet Name:", name(pset), "\n")
cat("PSet Class:", class(pset)[1], "\n")
cat("Dataset Type:", pset@datasetType, "\n\n")
# ============================================================================
# PART 2: TREATMENT RESPONSE (SENSITIVITY) DATA VALIDATION
# ============================================================================
cat("TREATMENT RESPONSE DATA (TRE)\n")
# Access TRE
tre <- treatmentResponse(pset)
cat("TRE Class:", class(tre)[1], "\n")
cat("TRE Dimensions:", paste(dim(tre), collapse=" x "), "\n")
cat("  - Rows (treatments):", nrow(tre), "\n")
cat("  - Cols (samples):", ncol(tre), "\n\n")
# Check assays
cat("Available assays in TRE:\n")
assay_names <- names(assays(tre))
cat("  ", paste(assay_names, collapse=", "), "\n\n")
# Access the raw sensitivity data
if ("raw" %in% assay_names) {
raw_data <- assay(tre, "raw")
cat("Raw assay details:\n")
cat("  Class:", class(raw_data)[1], "\n")
if (is(raw_data, "data.table") || is(raw_data, "data.frame")) {
cat("  Dimensions:", paste(dim(raw_data), collapse=" x "), "\n")
cat("  Columns:", paste(colnames(raw_data), collapse=", "), "\n")
cat("  First few rows:\n")
print(head(raw_data, 10))
# Check viability values
if ("viability" %in% colnames(raw_data)) {
viab <- raw_data$viability
cat("\n  Viability statistics:\n")
cat("    Min:", min(viab, na.rm=TRUE), "\n")
cat("    Max:", max(viab, na.rm=TRUE), "\n")
cat("    Mean:", mean(viab, na.rm=TRUE), "\n")
cat("    Median:", median(viab, na.rm=TRUE), "\n")
cat("    NAs:", sum(is.na(viab)), "\n")
# Check if viability is in reasonable range
if (max(viab, na.rm=TRUE) > 1.5) {
cat("    ✓ Viability appears to be in percentage (0-100) scale\n")
} else {
cat("    ✓ Viability appears to be in fraction (0-1) scale\n")
}
}
} else {
cat("  Dimensions:", paste(dim(raw_data), collapse=" x "), "\n")
cat("  Sample values:\n")
print(raw_data[1:min(5, nrow(raw_data)), 1:min(5, ncol(raw_data))])
}
} else {
cat("⚠ WARNING: No 'raw' assay found in TRE\n")
}
# Check rowData (treatment information)
cat("\nrowData (treatment metadata):\n")
row_data <- rowData(tre)
cat("  Columns:", paste(colnames(row_data), collapse=", "), "\n")
cat("  Number of unique drugs:", length(unique(row_data$drug_id)), "\n")
if ("dose_idx" %in% colnames(row_data)) {
cat("  Dose levels:", paste(sort(unique(row_data$dose_idx)), collapse=", "), "\n")
}
cat("  First few rows:\n")
print(head(as.data.frame(row_data), 5))
# Check colData (sample information)
cat("\ncolData (sample metadata):\n")
col_data <- colData(tre)
cat("  Columns:", paste(colnames(col_data), collapse=", "), "\n")
cat("  Number of unique samples:", length(unique(col_data$sampleid)), "\n")
cat("  First few rows:\n")
print(head(as.data.frame(col_data), 5))
# ============================================================================
# PART 3: MOLECULAR PROFILES VALIDATION
# ============================================================================
cat("\n")
cat("MOLECULAR PROFILES (MultiAssayExperiment)\n")
# Access MAE
mae <- molecularProfiles(pset)
cat("MAE Class:", class(mae)[1], "\n")
cat("Number of experiments:", length(mae), "\n")
cat("Experiment names:", paste(names(mae), collapse=", "), "\n\n")
# Check each experiment
for (exp_name in names(mae)) {
cat("--- Experiment:", exp_name, "---\n")
exp <- mae[[exp_name]]
cat("  Class:", class(exp)[1], "\n")
cat("  Dimensions:", paste(dim(exp), collapse=" x "), "\n")
cat("    - Features:", nrow(exp), "\n")
cat("    - Samples:", ncol(exp), "\n")
# Check assays
cat("  Assays:", paste(names(assays(exp)), collapse=", "), "\n")
# Get first assay
if (length(assays(exp)) > 0) {
first_assay <- assays(exp)[[1]]
cat("  First assay dimensions:", paste(dim(first_assay), collapse=" x "), "\n")
# Show sample of data
cat("  Sample of data (first 5x5):\n")
print(first_assay[1:min(5, nrow(first_assay)), 1:min(5, ncol(first_assay))])
# Statistics
cat("  Data statistics:\n")
cat("    Min:", min(first_assay, na.rm=TRUE), "\n")
cat("    Max:", max(first_assay, na.rm=TRUE), "\n")
cat("    Mean:", mean(first_assay, na.rm=TRUE), "\n")
cat("    NAs:", sum(is.na(first_assay)), "\n")
}
# Check rowData
if (nrow(rowData(exp)) > 0) {
cat("  rowData columns:", paste(colnames(rowData(exp)), collapse=", "), "\n")
}
# Check colData
if (nrow(colData(exp)) > 0) {
cat("  colData columns:", paste(colnames(colData(exp)), collapse=", "), "\n")
cat("  Sample IDs:", paste(head(colnames(exp), 5), collapse=", "), "...\n")
}
cat("\n")
}
# Check sampleMap
cat("Sample Map:\n")
smap <- sampleMap(mae)
cat("  Dimensions:", paste(dim(smap), collapse=" x "), "\n")
cat("  Columns:", paste(colnames(smap), collapse=", "), "\n")
cat("  First few rows:\n")
print(head(smap))
# ============================================================================
# PART 4: SAMPLE CONSISTENCY CHECK
# ============================================================================
cat("\n")
cat("SAMPLE CONSISTENCY CHECK\n")
# Get sample IDs from different slots
pset_samples <- sampleInfo(pset)$sampleid
tre_samples <- unique(colData(tre)$sampleid)
mae_samples <- colnames(mae)
cat("Samples in PSet sample info:", length(pset_samples), "\n")
cat("Samples in TRE:", length(tre_samples), "\n")
cat("Samples in MAE:", length(mae_samples), "\n\n")
# Check overlaps
tre_in_pset <- sum(tre_samples %in% pset_samples)
mae_in_pset <- sum(mae_samples %in% pset_samples)
cat("TRE samples in PSet sample info:", tre_in_pset, "/", length(tre_samples), "\n")
cat("MAE samples in PSet sample info:", mae_in_pset, "/", length(mae_samples), "\n\n")
# Find mismatches
missing_from_pset <- setdiff(c(tre_samples, mae_samples), pset_samples)
if (length(missing_from_pset) > 0) {
cat("⚠ WARNING: Samples in data but not in sample info:\n")
cat("  ", paste(head(missing_from_pset, 10), collapse=", "), "\n")
if (length(missing_from_pset) > 10) {
cat("  ... and", length(missing_from_pset) - 10, "more\n")
}
} else {
cat("✓ All data samples are in sample info\n")
}
# ============================================================================
# PART 5: CREATE EXAMPLE PLOTS
# ============================================================================
cat("\n")
cat("CREATING EXAMPLE PLOTS\n")
# Plot 1: Dose-response curve for one drug-cell combination
if ("raw" %in% assay_names) {
raw_data <- as.data.table(assay(tre, "raw"))
# Get first drug and first cell line
first_drug <- raw_data$drug_id[1]
first_cell <- raw_data$sampleid[1]
cat("Creating dose-response curve for:\n")
cat("  Drug:", first_drug, "\n")
cat("  Cell line:", first_cell, "\n\n")
# Extract data for this combination
curve_data <- raw_data[drug_id == first_drug & sampleid == first_cell]
if (nrow(curve_data) > 0) {
# Sort by concentration
curve_data <- curve_data[order(Concs)]
# Create plot
p1 <- ggplot(curve_data, aes(x = log10(Concs), y = viability)) +
geom_point(size = 3) +
geom_line() +
labs(
title = paste("Dose-Response Curve:", first_cell, "vs", first_drug),
x = "Log10(Concentration)",
y = "Viability (%)"
) +
theme_bw() +
theme(text = element_text(size = 12))
print(p1)
ggsave("dose_response_example.png", p1, width = 8, height = 6)
cat("✓ Saved dose_response_example.png\n\n")
}
# Plot 2: Viability distribution across all experiments
cat("Creating viability distribution plot...\n")
p2 <- ggplot(raw_data, aes(x = viability)) +
geom_histogram(bins = 50, fill = "steelblue", alpha = 0.7) +
labs(
title = "Distribution of Viability Values",
x = "Viability (%)",
y = "Count"
) +
theme_bw() +
theme(text = element_text(size = 12))
print(p2)
ggsave("viability_distribution.png", p2, width = 8, height = 6)
cat("✓ Saved viability_distribution.png\n\n")
# Plot 3: Number of experiments per cell line
cat("Creating experiments per cell line plot...\n")
exp_counts <- raw_data[, .(n_experiments = .N), by = sampleid]
exp_counts <- exp_counts[order(-n_experiments)]
p3 <- ggplot(exp_counts, aes(x = reorder(sampleid, n_experiments), y = n_experiments)) +
geom_bar(stat = "identity", fill = "coral") +
coord_flip() +
labs(
title = "Number of Experiments per Cell Line",
x = "Cell Line",
y = "Number of Experiments"
) +
theme_bw() +
theme(text = element_text(size = 10))
print(p3)
ggsave("experiments_per_cell.png", p3, width = 8, height = 10)
cat("✓ Saved experiments_per_cell.png\n\n")
}
# Plot 4: Mutation heatmap (if mutations available)
if ("mutations" %in% names(mae)) {
cat("Creating mutation heatmap...\n")
mut_exp <- mae[["mutations"]]
mut_mat <- assays(mut_exp)[[1]]
# Take top 20 most frequently mutated genes
gene_freq <- rowSums(mut_mat)
top_genes <- names(sort(gene_freq, decreasing = TRUE)[1:20])
# Subset matrix
mut_subset <- mut_mat[top_genes, ]
# Create heatmap
png("mutation_heatmap.png", width = 1000, height = 800)
heatmap(
mut_subset,
scale = "none",
col = c("white", "darkred"),
margins = c(10, 10),
main = "Top 20 Mutated Genes Across Cell Lines"
)
dev.off()
cat("✓ Saved mutation_heatmap.png\n\n")
}
# ============================================================================
# PART 6: DATA ACCESS EXAMPLES
# ============================================================================
cat("\n")
cat("DATA ACCESS EXAMPLES\n")
cat("# Example 1: Get all sensitivity data for one drug\n")
cat("drug_data <- assay(tre, 'raw')[drug_id == 'NCGC00013226-15']\n\n")
cat("# Example 2: Get all sensitivity data for one cell line\n")
cat("cell_data <- assay(tre, 'raw')[sampleid == 'EJM_DSMZ']\n\n")
cat("# Example 3: Get mutation data\n")
cat("mut_matrix <- assays(mae[['mutations']])[[1]]\n\n")
cat("# Example 4: Get mutations for one cell line\n")
cat("mutations_for_cell <- mut_matrix[, 'AMO1_DSMZ']\n")
cat("mutated_genes <- names(mutations_for_cell[mutations_for_cell == 1])\n\n")
cat("# Example 5: Get viability for specific drug-cell combination\n")
cat("specific <- assay(tre, 'raw')[drug_id == 'NCGC00013226-15' & sampleid == 'EJM_DSMZ']\n\n")
# ============================================================================
# PART 7: SUMMARY
# ============================================================================
cat("\n")
cat("VALIDATION SUMMARY\n")
checks <- list(
"PSet object created" = TRUE,
"TRE present" = !is.null(tre),
"Raw sensitivity data present" = "raw" %in% assay_names,
"MAE present" = !is.null(mae),
"Mutations present" = "mutations" %in% names(mae),
"Sample consistency" = length(missing_from_pset) == 0
)
for (check_name in names(checks)) {
status <- if(checks[[check_name]]) "✓" else "✗"
cat(status, check_name, "\n")
}
cat("\n")
cat("VALIDATION COMPLETE!\n")
