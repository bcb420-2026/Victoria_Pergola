pset
sample_ids <- colnames(mat)
sample_tbl <- data.frame(
sampleid = sample_ids,
tissueid = NA_character_,         # placeholder
stringsAsFactors = FALSE
)
treatment_tbl <- data.frame(
treatmentid = character(0),       # placeholder
drug_name = character(0),
stringsAsFactors = FALSE
)
# --- CONSTRUCT PSET2 ---------------------------------------------------------
pset <- PharmacoGx::PharmacoSet2(
name = "HMCL",
treatment = treatment_tbl,
sample = sample_tbl,
molecularProfiles = mae,
treatmentResponse = tre,
curation = cur,
datasetType = "sensitivity"
)
pset
saveRDS(pset, file = "HMCL_pset.rds")
